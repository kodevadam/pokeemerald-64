# ============================================================
#  Makefile.n64  —  pokeemerald N64 port build system
#  Target: Nintendo 64 (.z64 big-endian ROM, big-endian MIPS -EB)
#  Toolchain: mipsel-linux-gnu-gcc (big-endian mode -EB, bare-metal)
#
#  Why little-endian MIPS?
#    The GBA is little-endian.  All game data (palettes, tilemaps,
#    compressed data) is stored in little-endian byte order.
#    Compiling as little-endian MIPS means all struct layouts, u16/u32
#    reads from ROM data, and save data are correct without byte-swapping.
#    The N64 hardware registers (VI, AI, SI, PI, MI) are always big-endian
#    regardless of CPU mode; our HAL wraps those with N64_MMIO_RD/WR macros.
# ============================================================

# ---------- Basic configuration ----------------------------
FILE_NAME  := pokeemerald64
BUILD_DIR  := build/n64
ROM_NAME   := $(FILE_NAME).z64
ELF_NAME   := $(FILE_NAME).elf
MAP_NAME   := $(FILE_NAME).map

# ---------- Toolchain (mipsel = little-endian MIPS) -------
PREFIX := mipsel-linux-gnu-

CC      := $(PREFIX)gcc
AS      := $(PREFIX)as
LD      := $(PREFIX)ld
OBJCOPY := $(PREFIX)objcopy
OBJDUMP := $(PREFIX)objdump
NM      := $(PREFIX)nm
SIZE    := $(PREFIX)size

# ROM CRC fixer — build our own if not present
CHKSUM64 := $(BUILD_DIR)/tools/n64crc
CHKSUM64_SRC := tools/n64crc.c

# Data processing tools (host native)
PREPROC := tools/preproc/preproc
GFX     := tools/gbagfx/gbagfx
CHARMAP := charmap.txt

# ---------- Compiler flags --------------------------------
# -mips3       : MIPS III ISA  (VR4300 supports MIPS III)
# -mabi=32     : 32-bit ABI    (o32, avoids 64-bit ABI surprises)
# -EL          : little-endian output (implicit in mipsel- prefix, explicit here)
# -G0          : no small-data section (gp-relative addressing off — we have no gp)
# -mno-abicalls: no PIC, direct calls (bare-metal)
# -fno-pic     : no position-independent code
ARCH_FLAGS := -mips3 -mabi=32 -EB -G0 -mno-abicalls -fno-pic

CFLAGS := $(ARCH_FLAGS)                \
           -O2                         \
           -ffunction-sections         \
           -fdata-sections             \
           -fno-strict-aliasing        \
           -ffreestanding              \
           -Wall                       \
           -Wno-unused-function        \
           -Wno-unused-variable        \
           -Wno-unused-but-set-variable \
           -Wno-sign-compare           \
           -Wno-type-limits            \
           -Wno-address                \
           -Wno-array-bounds           \
           -Wno-missing-braces         \
           -Wno-discarded-qualifiers   \
           -Wno-incompatible-pointer-types \
           -DN64_PORT=1                \
           -DMODERN=1                  \
           -DNDEBUG                    \
           -DBUGFIX                    \
           -D_FORTIFY_SOURCE=0         \
           -iquote include             \
           -iquote include/n64

# CPP flags for the data assembly preprocessing step (no ARCH_FLAGS — runs on host)
# -include data/n64_specials_constants.inc: pre-defines SPECIAL_* constants so that
#   .2byte SPECIAL_X in specialvar macros resolves to an absolute value (no BFD_RELOC_16)
CPP_DATA_FLAGS := -E -DN64_PORT=1 -DMODERN=1 -Iinclude -Iinclude/n64 \
                  -include data/n64_specials_constants.inc

ASFLAGS := $(ARCH_FLAGS) -EB -iquote include -iquote include/n64

LDFLAGS := -T n64.ld                   \
            -Map $(BUILD_DIR)/$(MAP_NAME) \
            -m elf32btsmip             \
            --gc-sections              \
            -nostdlib                  \
            -static

# ---------- Source files ----------------------------------

# N64 platform sources (new files replacing GBA HAL)
N64_SRCS := \
    src/n64/crt0.s              \
    src/n64/platform.c          \
    src/n64/interrupt.c         \
    src/n64/bios.c              \
    src/n64/vi.c                \
    src/n64/tile_renderer.c     \
    src/n64/sprite_renderer.c   \
    src/n64/audio.c             \
    src/n64/input.c             \
    src/n64/flashram.c          \
    src/n64/dma3_stub.c         \
    src/n64/gpu_regs_n64.c      \
    src/n64/rtc_stub.c          \
    src/n64/link_stub.c         \
    src/n64/song_stubs.c        \
    src/n64/scanline_effect_n64.c \
    src/n64/rom_header.s        \
    src/n64/libc_impl.c

# Game sources — everything in src/ except files we replace
# Exclude GBA-specific hardware files superseded by N64 equivalents
EXCLUDED_SRCS := \
    src/m4a_1.s            \
    src/m4a.c              \
    src/crt0.s             \
    src/rom_header.s       \
    src/agb_flash.c        \
    src/agb_flash_1m.c     \
    src/agb_flash_le.c     \
    src/agb_flash_mx.c     \
    src/libgcnmultiboot.s  \
    src/siirtc.c           \
    src/librfu_sio32id.c   \
    src/librfu_rfu.c       \
    src/librfu_intr.c      \
    src/librfu_stwi.c      \
    src/gpu_regs.c         \
    src/link.c             \
    src/link_rfu_2.c       \
    src/link_rfu_3.c       \
    src/scanline_effect.c  \
    src/rtc.c              \
    src/libisagbprn.c      \
    src/multiboot.c        \
    src/dma3_manager.c

# All C sources from src/ (excluding replaced files)
ALL_C_SRCS    := $(shell find src -maxdepth 1 -name '*.c' | sort)
ALL_ASM_SRCS  := $(shell find src -maxdepth 1 -name '*.s' | sort)
EXCLUDED_SET  := $(EXCLUDED_SRCS)

GAME_C_SRCS   := $(filter-out $(EXCLUDED_SET), $(ALL_C_SRCS))
GAME_ASM_SRCS := $(filter-out $(EXCLUDED_SET), $(ALL_ASM_SRCS))

# data/*.s — GBA event scripts, text strings, battle scripts, sound data.
# These use preproc -e to convert C enums → GAS .equiv directives before assembly.
DATA_ASM_SRCS := $(shell find data -maxdepth 1 -name '*.s' | sort)

ALL_SRCS := $(N64_SRCS) $(GAME_C_SRCS) $(GAME_ASM_SRCS)

# ---------- Objects ---------------------------------------
C_SRCS   := $(filter %.c,   $(ALL_SRCS))
ASM_SRCS := $(filter %.s,   $(ALL_SRCS))

C_OBJS      := $(patsubst %.c,   $(BUILD_DIR)/%.o, $(C_SRCS))
ASM_OBJS    := $(patsubst %.s,   $(BUILD_DIR)/%.o, $(ASM_SRCS))
DATA_OBJS   := $(patsubst data/%.s, $(BUILD_DIR)/data/%.o, $(DATA_ASM_SRCS))
ALL_OBJS    := $(C_OBJS) $(ASM_OBJS) $(DATA_OBJS)

# ---------- Build rules -----------------------------------
.PHONY: all clean rom crc-tool

all: rom

rom: crc-tool $(BUILD_DIR)/$(ROM_NAME)

# Build the N64 CRC fixer tool (host native, not MIPS)
crc-tool: $(CHKSUM64)
$(CHKSUM64): $(CHKSUM64_SRC)
	@mkdir -p $(dir $@)
	gcc -O2 -o $@ $<

# Link ELF then extract raw binary for ROM
$(BUILD_DIR)/$(ROM_NAME): $(BUILD_DIR)/$(ELF_NAME)
	$(OBJCOPY) -O binary $< $@
	@# Pad to minimum 1 MB
	@SIZE=$$(wc -c < $@); \
	 PAD=$$((1048576 - $$SIZE)); \
	 if [ $$PAD -gt 0 ]; then \
	   dd if=/dev/zero bs=1 count=$$PAD >> $@ 2>/dev/null; \
	 fi
	@# Patch IPL3 into ROM header bytes 0x040-0x0FFF.
	@# Use pre-built libdragon IPL3 binary if present (recognized by SC64);
	@# otherwise fall back to assembling tools/ipl3.s.
	@if [ -f tools/ipl3_libdragon.bin ]; then \
	    python3 tools/patch_ipl3.py --bin tools/ipl3_libdragon.bin $@; \
	else \
	    python3 tools/patch_ipl3.py $@; \
	fi
	@# Fix ROM CRC checksums (computed over ROM[0x1000..], not the IPL3 region)
	$(CHKSUM64) $@
	@echo "ROM built: $@ ($$(wc -c < $@) bytes)"

$(BUILD_DIR)/$(ELF_NAME): $(ALL_OBJS) n64.ld
	@mkdir -p $(dir $@)
	$(LD) $(ALL_OBJS) $(LDFLAGS) -o $@
	$(SIZE) $@

# Compile C — run preproc first to handle INCBIN_* macros (embeds binary data)
# Pipeline: C source → CPP preprocess → preproc (expands INCBIN to hex) → compile
$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -E $< | $(PREPROC) -i $< $(CHARMAP) | sed 's/__asm__("svc [0-9]*")/__asm__("break")/g' | $(CC) $(CFLAGS) -MMD -MP -x c -c - -o $@

# Assemble .s (N64 platform sources)
$(BUILD_DIR)/%.o: %.s
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -x assembler-with-cpp -c $< -o $@

# Assemble data/*.s — GBA game data (scripts, text, battle animations, sound)
# Pipeline: preproc (charmap) → host CPP (expand #includes, -e converts enums→.equiv) → preproc -ie → as
# Note: $(AS) is the bare assembler; use only assembler-compatible flags (not GCC-only flags).
AS_ARCH_FLAGS := -mips3 -mabi=32 -EB -G0
$(BUILD_DIR)/data/%.o: data/%.s
	@mkdir -p $(dir $@)
	$(PREPROC) $< charmap.txt | gcc $(CPP_DATA_FLAGS) - | $(PREPROC) -ie $< charmap.txt | $(AS) $(AS_ARCH_FLAGS) -o $@

# ---------- Data file generation rules ----------------------------
# Generate 4bpp/8bpp/pal binary data from source files using gbagfx.
# These are needed by INCBIN_U32 macros in game source files.
%.4bpp:   %.png  ; $(GFX) $< $@
%.8bpp:   %.png  ; $(GFX) $< $@
%.gbapal: %.pal  ; $(GFX) $< $@
%.gbapal: %.png  ; $(GFX) $< $@
%.lz:     %      ; $(GFX) $< $@
%.rl:     %      ; $(GFX) $< $@
%.1bpp:   %.png  ; $(GFX) $< $@

clean:
	rm -rf $(BUILD_DIR)

# Include generated dependency files
-include $(C_OBJS:.o=.d)

# Convenience targets
disasm: $(BUILD_DIR)/$(ELF_NAME)
	$(OBJDUMP) -d -M no-aliases $< > $(BUILD_DIR)/$(FILE_NAME).dis

sizes: $(BUILD_DIR)/$(ELF_NAME)
	$(NM) --size-sort --print-size $< | head -40
